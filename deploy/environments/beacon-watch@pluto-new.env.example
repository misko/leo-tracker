# Install as /etc/leo-tracker/beacon-watch@pluto-new.env (mode 0640).
# Current discovery identity (2026-08-09): v0.38 custom firmware.
LEO_BEACON_RADIO_ID=pluto-5d4d
LEO_BEACON_RADIO_URI=pluto://usb:
LEO_BEACON_RADIO_SERIAL=1040005e0b100007100010000bf33a5d4d
LEO_BEACON_RECEIVER_LABELS="lnb-a lnb-b"

# Both instances intentionally share the immutable capture tree and its one
# durable offload queue. Radio ID makes capture and queue names disjoint.
LEO_BEACON_STORAGE=/mnt/leo-nvme/leo-tracker
LEO_BEACON_MINIMUM_FREE_GB=200

# Keep the accepted radio's existing production survey cadence.
LEO_BEACON_TARGETS=4:lower-edge
LEO_BEACON_OVERSAMPLE_ON_STARTUP=1
LEO_BEACON_OVERSAMPLE_EVERY_CYCLES=10
LEO_BEACON_WIDE_EVERY_CYCLES=15
LEO_BEACON_HOP_EVERY_CYCLES=2
