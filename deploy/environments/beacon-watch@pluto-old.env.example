# Install as /etc/leo-tracker/beacon-watch@pluto-old.env (mode 0640).
# Current discovery identity (2026-08-09): v0.32-1-g7bdc-dirty.
LEO_BEACON_RADIO_ID=pluto-19f2
LEO_BEACON_RADIO_URI=pluto://usb:
LEO_BEACON_RADIO_SERIAL=10400056f695001322002d0010ad1719f2
LEO_BEACON_RECEIVER_LABELS="lnb-c lnb-d"

LEO_BEACON_STORAGE=/mnt/leo-nvme/leo-tracker
LEO_BEACON_MINIMUM_FREE_GB=200
LEO_BEACON_TARGETS=4:lower-edge

# Initial compatibility/soak profile: continuous narrow capture only. This
# avoids synchronizing two high-rate bursts until the v0.32 radio passes a
# bounded dual-RX throughput and lifecycle test.
LEO_BEACON_OVERSAMPLE_ON_STARTUP=0
LEO_BEACON_OVERSAMPLE_EVERY_CYCLES=0
LEO_BEACON_WIDE_EVERY_CYCLES=0
LEO_BEACON_HOP_EVERY_CYCLES=0
