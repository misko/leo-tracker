[Unit]
Description=Kalman single-writer DuckDB analysis store
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/qnap01/mouse9911/leo

[Service]
Type=simple
User=mouse9911
Group=mouse9911
WorkingDirectory=/home/mouse9911/gits/leo-tracker
StateDirectory=leo-tracker-analysis-store
Environment=VIRTUAL_ENV=/home/mouse9911/gits/leo-tracker/.venv
Environment=UV_CACHE_DIR=/home/mouse9911/gits/leo-tracker/.uv-cache
ExecStart=/home/mouse9911/.local/bin/uv run --active --no-sync leo-radio \
  starlink-analysis-store service /var/lib/leo-tracker-analysis-store \
  --shared-root /mnt/qnap01/mouse9911/leo \
  --publication-root /mnt/qnap01/mouse9911/leo/database \
  --runtime-output /mnt/qnap01/mouse9911/leo/reports/runtime/analysis-store.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
