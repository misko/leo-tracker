[Unit]
Description=LEO tracker six-hour verified-v2 QNAP raw-IQ reclaimer
After=network-online.target mnt-qnap01.mount
Wants=network-online.target
Requires=mnt-qnap01.mount

[Service]
Type=simple
User=satpi01
Group=satpi01
WorkingDirectory=/home/satpi01/leo-tracker
Environment=UV_BIN=/home/satpi01/.local/bin/uv
Environment=LEO_QNAP_RECLAIM_ENABLED=1
Environment=LEO_QNAP_RECLAIM_INTERVAL_S=60
Environment=LEO_QNAP_RECLAIM_MAXIMUM_TIER=4
Environment=LEO_QNAP_RECLAIM_MINIMUM_AGE_HOURS=6
Environment=LEO_QNAP_RECLAIM_IGNORE_PRESSURE=1
Environment=LEO_QNAP_RECLAIM_TRIGGER_FREE_GB=500
Environment=LEO_QNAP_RECLAIM_TARGET_FREE_GB=750
ExecStart=/home/satpi01/leo-tracker/scripts/starlink-qnap-lifecycle.sh /mnt/qnap01/mouse9911/leo /mnt/qnap01/mouse9911/leo-cropped
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
