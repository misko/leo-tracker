[Unit]
Description=LEO tracker historical storage convergence to tiered v2 evidence
After=network-online.target mnt-qnap01.mount
Wants=network-online.target
Requires=mnt-qnap01.mount

[Service]
Type=simple
User=mouse9911
Group=mouse9911
WorkingDirectory=/home/mouse9911/gits/leo-tracker
Environment=UV_BIN=/home/mouse9911/.local/bin/uv
Environment=UV_CACHE_DIR=/home/mouse9911/gits/leo-tracker/.uv-cache
Environment=LEO_TRACKER_REPO=/home/mouse9911/gits/leo-tracker
Environment=LEO_STORAGE_REGIME_ENABLED=1
Environment=LEO_STORAGE_REGIME_INTERVAL_S=60
Environment=LEO_STORAGE_REGIME_LIMIT=32
Environment=LEO_STORAGE_REGIME_PLANNING_LIMIT=128
Environment=LEO_STORAGE_REGIME_WORKERS=16
Environment=LEO_STORAGE_REGIME_ARCHIVE_SLOTS=16
Environment=LEO_STORAGE_REGIME_MINIMUM_AGE_HOURS=6
Environment=LEO_STORAGE_REGIME_ROLE=primary
Environment=LEO_STORAGE_PRIMARY_HEARTBEAT_S=30
Environment=LEO_STORAGE_PRIMARY_LEASE_MAX_AGE_S=120
Environment=LEO_STORAGE_AUDIT_INTERVAL_S=600
ExecStart=/home/mouse9911/gits/leo-tracker/scripts/starlink-storage-regime-v2.sh /mnt/qnap01/mouse9911/leo /mnt/qnap01/mouse9911/leo-cropped
Restart=on-failure
RestartSec=30
KillMode=process
TimeoutStopSec=1800

[Install]
WantedBy=multi-user.target
