[Unit]
Description=Fetch and archive immutable Starlink TLE catalog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=satpi01
Group=users
WorkingDirectory=/home/satpi01/leo-tracker
Environment=VIRTUAL_ENV=/home/satpi01/leo-tracker/.venv
# Space-Track is the authoritative origin; Celestrak already blocks this host.
# Credentials live outside the repository in a 0600 file so they reach neither
# git nor a process listing. See docs/tle-sources.md.
EnvironmentFile=/etc/leo-tracker/space-track.env
# decay_date/null-val keeps the query to propagable objects, which Space-Track
# asks for explicitly, and one catalog query replaces per-object requests.
ExecStart=/home/satpi01/.local/bin/uv run --active --no-sync leo-orbit archive \
  --url "https://www.space-track.org/basicspacedata/query/class/gp/OBJECT_NAME/~~STARLINK/decay_date/null-val/orderby/NORAD_CAT_ID/format/3le" \
  --archive-dir /mnt/qnap01/mouse9911/satellites/leo-tracker/tle-history \
  --label starlink-current

[Install]
WantedBy=multi-user.target
