[Unit]
Description=Continuous Starlink edge-pilot dual-RX capture and analysis
After=network-online.target mnt-leo\x2dnvme.mount
Wants=network-online.target
Requires=mnt-leo\x2dnvme.mount

[Service]
Type=simple
User=satpi01
Group=satpi01
WorkingDirectory=/home/satpi01/leo-tracker
Environment=UV_CACHE_DIR=/home/satpi01/leo-tracker/.uv-cache
ExecStart=/home/satpi01/leo-tracker/scripts/starlink-beacon-watch.sh
Restart=always
RestartSec=10
# Signal only the watcher first. Bash defers its trap while a foreground radio
# capture runs, so the checksummed capture can finish before descendants are
# terminated. The longest current 10 MS/s trial takes about 122 seconds.
KillMode=mixed
TimeoutStopSec=300
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
