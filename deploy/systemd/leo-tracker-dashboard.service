[Unit]
Description=LEO tracker read-only dashboard
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/qnap01/mouse9911/leo

[Service]
Type=exec
User=satpi01
Group=users
WorkingDirectory=/home/satpi01/leo-tracker
CacheDirectory=leo-tracker-analysis-store
Environment=VIRTUAL_ENV=/home/satpi01/leo-tracker/.venv
Environment=UV_CACHE_DIR=/home/satpi01/leo-tracker/.uv-cache
# The pre-dwell surveys stay on the capture host's local storage root, which is
# not the archive this dashboard reads, so the directory has to be named. It is
# deliberately not a RequiresMountsFor: an absent NVMe should cost the survey
# pictures, not the console that would explain why the NVMe is absent.
ExecStart=/home/satpi01/.local/bin/uv run --active --no-sync leo-radio \
  starlink-dashboard artifacts/starlink_hybrid_watch \
  --beacon-root /mnt/qnap01/mouse9911/leo \
  --survey-plot-dir /mnt/leo-nvme/leo-tracker/plots \
  --analysis-store-pointer /mnt/qnap01/mouse9911/leo/database/current.json \
  --analysis-store-cache /var/cache/leo-tracker-analysis-store \
  --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
