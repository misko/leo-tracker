[Unit]
Description=Continuous dual-RX Starlink survey and Doppler tracker ensemble
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/satpi01/leo-tracker
Environment=VIRTUAL_ENV=/home/satpi01/leo-tracker/.venv
Environment=UV_CACHE_DIR=/home/satpi01/leo-tracker/.uv-cache
Environment=MPLCONFIGDIR=/tmp/leo-tracker-mpl
ExecStart=/bin/bash scripts/starlink_hybrid_watch.sh artifacts/starlink_hybrid_watch
Restart=always
RestartSec=10s

[Install]
WantedBy=default.target
