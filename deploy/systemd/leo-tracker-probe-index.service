[Unit]
Description=Project per-probe beacon facts into day-partitioned parquet
After=network-online.target
ConditionPathIsDirectory=/mnt/qnap01/mouse9911/leo/reports

[Service]
Type=oneshot
User=satpi01
WorkingDirectory=/home/satpi01/leo-tracker
# Only days whose report count has moved are rebuilt, so in steady state this
# touches today alone. Niced and idle-IO because it shares a three-gigabyte
# host with two continuous captures.
Nice=19
IOSchedulingClass=idle
ExecStart=/home/satpi01/leo-tracker/.venv/bin/leo-radio starlink-probe-index build /mnt/qnap01/mouse9911/leo
TimeoutStartSec=3600
