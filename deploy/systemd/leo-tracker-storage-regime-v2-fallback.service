[Unit]
Description=Low-rate fallback for LEO historical storage convergence
After=network-online.target mnt-qnap01.mount leo-tracker-analysis-export.service
Wants=network-online.target
Requires=mnt-qnap01.mount

[Service]
Type=simple
User=satpi01
Group=satpi01
WorkingDirectory=/home/satpi01/leo-tracker
Environment=UV_BIN=/home/satpi01/.local/bin/uv
Environment=UV_CACHE_DIR=/home/satpi01/leo-tracker/.uv-cache
Environment=LEO_TRACKER_REPO=/home/satpi01/leo-tracker
Environment=LEO_STORAGE_REGIME_ENABLED=1
Environment=LEO_STORAGE_REGIME_INTERVAL_S=10
Environment=LEO_STORAGE_REGIME_LIMIT=12
Environment=LEO_STORAGE_REGIME_PLANNING_LIMIT=80
Environment=LEO_STORAGE_REGIME_WORKERS=6
Environment=LEO_STORAGE_REGIME_ARCHIVE_SLOTS=1
Environment=LEO_STORAGE_REGIME_MINIMUM_AGE_HOURS=6
Environment=LEO_STORAGE_REGIME_ROLE=fallback
Environment=LEO_STORAGE_PRIMARY_HEARTBEAT_S=30
Environment=LEO_STORAGE_PRIMARY_LEASE_MAX_AGE_S=120
Environment=LEO_STORAGE_AUDIT_INTERVAL_S=600
Environment=LEO_STORAGE_LOCAL_ROOT=/mnt/leo-nvme/leo-tracker
ExecStart=/home/satpi01/leo-tracker/scripts/starlink-storage-regime-v2.sh /mnt/qnap01/mouse9911/leo /mnt/qnap01/mouse9911/leo-cropped
Restart=on-failure
RestartSec=30
KillMode=process
TimeoutStopSec=1800
Nice=10
CPUWeight=20
IOWeight=20

[Install]
WantedBy=multi-user.target
