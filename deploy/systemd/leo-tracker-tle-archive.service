[Unit]
Description=Fetch and archive immutable Starlink TLE catalog
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/satpi01/leo-tracker
Environment=VIRTUAL_ENV=/home/satpi01/leo-tracker/.venv
ExecStart=/home/satpi01/.local/bin/uv run --active --no-sync leo-orbit archive --url https://huggingface.co/datasets/juliensimon/starlink-tle-latest/resolve/main/data/starlink.tle --archive-dir /mnt/qnap01/mouse9911/satellites/leo-tracker/tle-history --label starlink-current
