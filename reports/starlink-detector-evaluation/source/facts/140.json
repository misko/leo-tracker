  "s05_null_per_point": {
    "src": "figures/injection/false-alarm-165.json",
    "ptr": "/nominal_per_point",
    "fmt": "pct1",
    "note": "the per-point false-alarm rate the thresholds are set to; the same 0.01 appears as figures/cfo-cliff.json /false_alarm_rate and figures/edge-pilots.json /selection/false_alarm_rate"
  },
  "s05_null_per_point_survive": {
    "expr": "1 - q",
    "inputs": {
      "q": "s05_null_per_point"
    },
    "fmt": "f2",
    "note": "the per-point survival probability the cell-level arithmetic raises to the number of candidate points"
  },
