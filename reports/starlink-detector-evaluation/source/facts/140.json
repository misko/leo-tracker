  },
  "s05_predicted_per_cell": {
    "src": "figures/injection/false-alarm-165.json",
    "ptr": "/predicted_per_cell",
    "fmt": "pct1",
    "note": "1 - (1 - nominal_per_point) ** mean_points_per_cell, computed in the sidecar itself"
  },

