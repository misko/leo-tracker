  "s11_snr50_reproduction": {
    "expr": "((a1 - b1) ** 2 + (a2 - b2) ** 2 + (a3 - b3) ** 2 + (a4 - b4) ** 2 + (a5 - b5) ** 2 + (a6 - b6) ** 2 + (a7 - b7) ** 2 + (a8 - b8) ** 2) ** 0.5",
    "inputs": {
      "a1": "s11_a2snr50_glrt32",
      "b1": "s11_snr50_glrt32",
      "a2": "s11_a2snr50_ffverify",
      "b2": "s11_snr50_ffverify",
      "a3": "s11_a2snr50_ffacquire",
      "b3": "s11_snr50_ffacquire",
      "a4": "s11_a2snr50_fffull",
      "b4": "s11_snr50_fffull",
      "a5": "s11_a2snr50_glrt64",
      "b5": "s11_snr50_glrt64",
      "a6": "s11_a2snr50_anchor8",
      "b6": "s11_snr50_anchor8",
      "a7": "s11_a2snr50_diff32",
      "b7": "s11_snr50_diff32",
      "a8": "s11_a2snr50_diff16",
      "b8": "s11_snr50_diff16"
    },
    "fmt": "f4",
    "note": "Euclidean norm of the eight SNR50 differences between the 15b re-analysis and the ranking figure; an upper bound on the largest single discrepancy, so 0.0000 dB means every detector reproduced"
  },
