  },
  "s900_inj_rate": {
    "expr": "hz / 1000000",
    "fmt": "f0",
    "inputs": {
      "hz": "s900_inj_rate_hz"
    },
    "note": "the sidecar stores Hz; the template writes the MS/s unit"
  },
  "s900_inj_probe": {
    "src": "injection-data/one-radio/summary.json",
    "ptr": "/configuration/probe_ms",
    "fmt": "f0",
