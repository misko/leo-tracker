  "s900_recheck_sweeps_added": {
    "expr": "firerate + coincidence",
    "fmt": "int",
    "inputs": {
      "firerate": "s900_firerate_sweeps_added",
      "coincidence": "s900_coincidence_sweeps_added"
    },
    "note": "summed over the two runs whose recheck records the delta as a scalar; the opening pair records it as an empty list of names, which is the same claim in another shape"
  },
  "s900_recheck_sidecars_removed": {
    "expr": "firerate + coincidence",
    "fmt": "int",
    "inputs": {
      "firerate": "s900_firerate_sidecars_removed",
      "coincidence": "s900_coincidence_sidecars_removed"
    },
    "note": "summed over the two runs whose recheck records the delta as a scalar; the opening pair records it as an empty list of names, which is the same claim in another shape"
  },
