  },
  "s900_inj_far_fraction": {
    "src": "injection-data/one-radio/thresholds.json",
    "ptr": "/false_alarm_rate",
    "fmt": "f2"
  },
  "s900_inj_far": {
    "expr": "fraction * 100",
    "fmt": "f0",
    "inputs": {
      "fraction": "s900_inj_far_fraction"
    },
    "note": "pct1 would print 1.0%; the report writes a whole percent, so the scaling is explicit here"
  },
